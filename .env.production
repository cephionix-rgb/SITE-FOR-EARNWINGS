# Production build-time env — Vite reads this for `vite build` (used by the GitHub Actions deploy).
# The waitlist endpoint is a public Apps Script URL (it's already visible in the built JS), so it's fine here.
VITE_WAITLIST_ENDPOINT=https://script.google.com/macros/s/AKfycbx30VUYUCsfb99yg7qio973nU8gxMMboPVVBqvmg7uaR9MZw4JVnSm_PE3yAXZ7e_rSIg/exec

# Paste your GA4 Measurement ID (looks like G-XXXXXXXXXX) here to turn analytics on, then push (it auto-redeploys). Blank = off.
VITE_GA_ID=G-NCMD93D8MN

# The API the account page signs in and buys against.
#
# THIS FILE, NOT .env — .env is gitignored, so CI builds with nothing and `BASE`
# becomes "". Every call then resolves against the marketing origin, /auth/login is a
# 404 on GitHub Pages, and the account page loads perfectly while never working. See
# the header of src/lib/api.ts.
#
# It must also stay listed in the CSP connect-src in vercel.json, or the browser blocks
# each request before it is sent — which does not look like a network error, it looks
# like nothing happening at all.
VITE_CORE_URL=https://api.earnwings.org
VITE_SITE_URL=https://earnwings.org
# Sign in with Google on /account (see .env.example). Public client id.
VITE_GOOGLE_WEB_CLIENT_ID=289443816051-08vdlq5da9evqqkdneo0s2nvenjck43n.apps.googleusercontent.com
VITE_GOOGLE_WEB_ORIGINS=https://earnwings.org,https://www.earnwings.org
