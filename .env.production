# Production build-time env — Vite reads this for `vite build` (used by the GitHub Actions deploy).
# The waitlist endpoint is a public Apps Script URL (it's already visible in the built JS), so it's fine here.
VITE_WAITLIST_ENDPOINT=https://script.google.com/macros/s/AKfycbzdoF7AZInWJffaFHR9slGb8ChIYNAg74PDstHtMkd5A_TUx7cPwT8hRZDGJdmSsoSGAw/exec

# Paste your GA4 Measurement ID (looks like G-XXXXXXXXXX) here to turn analytics on, then push (it auto-redeploys). Blank = off.
VITE_GA_ID=
