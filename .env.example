# The EARNWINGS core API the account page talks to.
#
# Unset, every request goes to the marketing origin and 404s — the sign-in form will
# simply say it cannot reach the API.
#
# TWO PLACES MUST AGREE OR THIS SILENTLY FAILS:
#   1. vercel.json → Content-Security-Policy → connect-src must list this origin, or
#      the browser blocks each request before it is sent. A CSP block does not surface
#      as a network error; it surfaces as nothing happening at all.
#   2. The core service's ALLOWED_ORIGINS must list THIS site's origin, or the browser
#      rejects the response for CORS.
VITE_CORE_URL=https://api.earnwings.org

# Where the EarnWings app (and its 3D airport viewer) is served. Used by the live-airports
# embed on / and /live. No trailing slash. Changes whenever the app host tunnel changes;
# see README "Live at our airports" for the two headers that must agree with it.
VITE_APP_HOST_URL=https://optimal-bufing-joshua-villas.trycloudflare.com

# Optional: core API host for the live embed's traffic feed (https only), passed as &core=.
# VITE_LIVE_CORE_URL=https://api.earnwings.org

# ── Sign in with Google / Apple on /account (src/lib/socialWeb.ts) ──
# Each button shows only when its id is set here, core has the same id in its own list
# (GOOGLE_CLIENT_IDS / APPLE_CLIENT_IDS), AND the page is served from an origin the
# provider has registered. See _docs/LAUNCH_KEYS_NEEDED.md.
#
# Google: the "Web application" OAuth client id. Public (it is in every page that uses it).
VITE_GOOGLE_WEB_CLIENT_ID=289443816051-08vdlq5da9evqqkdneo0s2nvenjck43n.apps.googleusercontent.com
# The origins listed as "Authorized JavaScript origins" on that client. The button is
# hidden on any other origin (e.g. a trycloudflare preview), rather than failing.
VITE_GOOGLE_WEB_ORIGINS=https://earnwings.org,https://www.earnwings.org
# Apple: a Services ID with Sign in with Apple enabled, and a Return URL registered on
# it (https, on earnwings.org). Leave empty until both exist; the button stays hidden.
VITE_APPLE_SERVICES_ID=
VITE_APPLE_REDIRECT_URI=
# Cloudflare Turnstile needs NOTHING here: core hands the site key to the page through
# GET /auth/providers once TURNSTILE_SITE_KEY and TURNSTILE_SECRET are set in core's env.
